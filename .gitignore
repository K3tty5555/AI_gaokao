# 爬虫运行时日志(每次跑都会变,不进 git)
# 统一写到 logs/ 子目录,根目录 crawl*.log 是历史遗留
logs/
crawl*.log
crawl*.stdout.log

# /tmp/ 不在项目根,无需 ignore

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# OS
.DS_Store
Thumbs.db

# 编辑器
.vscode/
.idea/
*.swp

# Agent 临时产物(playwright/claude-code 子任务的临时文件,不进 git)
.playwright-mcp/

# 数据库:.db 文件已通过 .gitattributes 标为 binary,
# 本项目主动把 data/gaokao_hubei.db 提交进 git(便于 clone 即用),
# 所以这里不忽略 .db。

# 咨询报告输出(用户数据,不进 git)
output/
